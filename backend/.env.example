# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DATABASE_URL="postgresql://username:Garrdes69@localhost:5432/sanaf_erp?schema=public"

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-secret-key-change-in-production-min-32-characters
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production-min-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File Upload
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR=./uploads

# Optional: Email Configuration (for notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-password
# SMTP_FROM=noreply@sanaf.com
