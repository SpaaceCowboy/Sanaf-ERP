# ==================== DATABASE ====================
DATABASE_URL="postgresql://username:password@localhost:5432/electroflow_erp?schema=public"

# ==================== SERVER ====================
PORT=5000
NODE_ENV=development

# ==================== JWT SECRETS ====================
# IMPORTANT: Change these in production! Use strong random strings
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==================== CORS ====================
CORS_ORIGIN=http://localhost:3000

# ==================== COMPANY INFO (for PDF generation) ====================
COMPANY_NAME="ElectroFlow ERP Industries Ltd."
COMPANY_ADDRESS="123 Industrial Zone, Tech City, State 12345"
COMPANY_COUNTRY="United States"
COMPANY_PHONE="+1 (555) 123-4567"
COMPANY_EMAIL="contact@electroflow.com"
COMPANY_WEBSITE="www.electroflow.com"
COMPANY_TAX_ID="TAX-123456789"

# ==================== BANK INFO (for invoices) ====================
COMPANY_BANK_NAME="International Business Bank"
COMPANY_BANK_ACCOUNT="****4567"
COMPANY_BANK_SWIFT="IBBKUS33"

# ==================== AUTHORIZED SIGNATORY ====================
COMPANY_AUTHORIZED_NAME="John Doe"
COMPANY_AUTHORIZED_TITLE="Export Manager"

# ==================== FILE STORAGE ====================
DOCUMENTS_DIR=./documents
UPLOADS_DIR=./uploads
