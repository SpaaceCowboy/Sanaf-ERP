// ElectroFlow ERP Database Schema
// PostgreSQL database with Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USER MANAGEMENT ====================

enum Role {
  ADMIN
  MANAGER
  WAREHOUSE
  PRODUCTION
  SALES
  VIEWER
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  firstName     String
  lastName      String
  role          Role      @default(VIEWER)
  department    String?
  phone         String?
  avatar        String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  orders        Order[]       @relation("CreatedOrders")
  assignedTasks ProjectTask[] @relation("AssignedTasks")
  projects      Project[]     @relation("ProjectManager")
  auditLogs     AuditLog[]
  documents     Document[]    @relation("GeneratedBy")
  inventoryMovements InventoryMovement[]

  @@map("users")
}

// ==================== CUSTOMER & SUPPLIER ====================

model Customer {
  id            String    @id @default(uuid())
  companyName   String
  contactName   String
  email         String    @unique
  phone         String?
  address       String
  city          String
  country       String
  postalCode    String?
  taxId         String?
  notes         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  orders        Order[]

  @@map("customers")
}

model Supplier {
  id            String    @id @default(uuid())
  companyName   String
  contactName   String
  email         String    @unique
  phone         String?
  address       String
  city          String
  country       String
  postalCode    String?
  taxId         String?
  leadTimeDays  Int       @default(7)
  rating        Float?
  notes         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  inventory     InventoryItem[]
  imports       InventoryMovement[] @relation("SupplierMovements")

  @@map("suppliers")
}

// ==================== ORDER MANAGEMENT ====================

enum OrderStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  QUALITY_CHECK
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique
  customerId      String
  createdById     String
  status          OrderStatus   @default(DRAFT)
  paymentStatus   PaymentStatus @default(PENDING)
  
  // Pricing
  subtotal        Decimal       @db.Decimal(12, 2)
  taxRate         Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount       Decimal       @db.Decimal(12, 2)
  shippingCost    Decimal       @default(0) @db.Decimal(10, 2)
  discount        Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal       @db.Decimal(12, 2)
  
  // Shipping
  shippingAddress String
  shippingCity    String
  shippingCountry String
  shippingMethod  String?
  trackingNumber  String?
  
  // Dates
  orderDate       DateTime      @default(now())
  requiredDate    DateTime
  shippedDate     DateTime?
  deliveredDate   DateTime?
  
  // Export Info
  exportLicense   String?
  hsCode          String?
  incoterms       String?       // FOB, CIF, EXW, etc.
  
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  customer        Customer      @relation(fields: [customerId], references: [id])
  createdBy       User          @relation("CreatedOrders", fields: [createdById], references: [id])
  items           OrderItem[]
  project         Project?
  documents       Document[]

  @@map("orders")
}

model OrderItem {
  id              String    @id @default(uuid())
  orderId         String
  inventoryItemId String?
  productName     String
  productCode     String
  description     String?
  quantity        Int
  unitPrice       Decimal   @db.Decimal(10, 2)
  totalPrice      Decimal   @db.Decimal(12, 2)
  hsCode          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  @@map("order_items")
}

// ==================== PROJECT MANAGEMENT ====================

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
}

model Project {
  id              String        @id @default(uuid())
  projectNumber   String        @unique
  name            String
  description     String?
  orderId         String?       @unique
  managerId       String
  status          ProjectStatus @default(PLANNING)
  priority        TaskPriority  @default(MEDIUM)
  
  // Dates
  startDate       DateTime
  dueDate         DateTime
  completedDate   DateTime?
  
  // Progress
  progress        Int           @default(0) // 0-100
  estimatedHours  Int?
  actualHours     Int?
  
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  order           Order?        @relation(fields: [orderId], references: [id])
  manager         User          @relation("ProjectManager", fields: [managerId], references: [id])
  tasks           ProjectTask[]
  materials       ProjectMaterial[]

  @@map("projects")
}

model ProjectTask {
  id              String       @id @default(uuid())
  projectId       String
  assigneeId      String?
  title           String
  description     String?
  status          TaskStatus   @default(TODO)
  priority        TaskPriority @default(MEDIUM)
  
  // Dates
  startDate       DateTime?
  dueDate         DateTime?
  completedDate   DateTime?
  
  // Time tracking
  estimatedHours  Int?
  actualHours     Int?
  
  // Checklist
  isChecklist     Boolean      @default(false)
  checklistItems  Json?        // [{id, text, completed}]
  
  sortOrder       Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee        User?        @relation("AssignedTasks", fields: [assigneeId], references: [id])

  @@map("project_tasks")
}

model ProjectMaterial {
  id              String        @id @default(uuid())
  projectId       String
  inventoryItemId String
  requiredQty     Int
  allocatedQty    Int           @default(0)
  usedQty         Int           @default(0)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@map("project_materials")
}

// ==================== INVENTORY MANAGEMENT ====================

enum ItemType {
  RAW_MATERIAL
  COMPONENT
  FINISHED_GOOD
  PACKAGING
}

enum MovementType {
  IMPORT
  EXPORT
  PRODUCTION_IN
  PRODUCTION_OUT
  ADJUSTMENT
  RETURN
  SCRAP
}

model InventoryItem {
  id              String    @id @default(uuid())
  sku             String    @unique
  name            String
  description     String?
  type            ItemType  @default(RAW_MATERIAL)
  category        String
  
  // Stock levels
  quantity        Int       @default(0)
  reservedQty     Int       @default(0)
  minStock        Int       @default(0)
  maxStock        Int?
  reorderPoint    Int       @default(10)
  
  // Pricing
  unitCost        Decimal   @db.Decimal(10, 2)
  currency        String    @default("USD")
  
  // Details
  unit            String    @default("PCS") // PCS, KG, M, L, etc.
  weight          Decimal?  @db.Decimal(10, 3)
  dimensions      String?   // LxWxH
  
  // Import/Export
  hsCode          String?
  countryOfOrigin String?
  supplierId      String?
  
  // Location
  warehouseZone   String?
  binLocation     String?
  
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  supplier        Supplier?           @relation(fields: [supplierId], references: [id])
  movements       InventoryMovement[]
  orderItems      OrderItem[]
  projectMaterials ProjectMaterial[]

  @@map("inventory_items")
}

model InventoryMovement {
  id              String       @id @default(uuid())
  inventoryItemId String
  userId          String
  supplierId      String?
  type            MovementType
  quantity        Int
  previousQty     Int
  newQty          Int
  unitCost        Decimal?     @db.Decimal(10, 2)
  totalCost       Decimal?     @db.Decimal(12, 2)
  
  // Reference
  referenceType   String?      // ORDER, PROJECT, ADJUSTMENT
  referenceId     String?
  
  // Import details
  importBatchNo   String?
  importDate      DateTime?
  expiryDate      DateTime?
  
  notes           String?
  createdAt       DateTime     @default(now())

  // Relations
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  user            User          @relation(fields: [userId], references: [id])
  supplier        Supplier?     @relation("SupplierMovements", fields: [supplierId], references: [id])

  @@map("inventory_movements")
}

// ==================== DOCUMENTS ====================

enum DocumentType {
  INVOICE
  PROFORMA_INVOICE
  PACKING_LIST
  COMMERCIAL_INVOICE
  BILL_OF_LADING
  CERTIFICATE_OF_ORIGIN
  EXPORT_LICENSE
  CUSTOMS_DECLARATION
}

model Document {
  id              String       @id @default(uuid())
  documentNumber  String       @unique
  type            DocumentType
  orderId         String?
  generatedById   String
  
  // File info
  fileName        String
  filePath        String
  fileSize        Int
  mimeType        String       @default("application/pdf")
  
  // Metadata
  metadata        Json?
  
  createdAt       DateTime     @default(now())

  // Relations
  order           Order?       @relation(fields: [orderId], references: [id])
  generatedBy     User         @relation("GeneratedBy", fields: [generatedById], references: [id])

  @@map("documents")
}

// ==================== AUDIT LOG ====================

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String   // CREATE, UPDATE, DELETE, LOGIN, etc.
  entity      String   // Order, Project, Inventory, etc.
  entityId    String?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  // Relations
  user        User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// ==================== SETTINGS ====================

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("settings")
}
